%SRCG%L/* distribution. A copy is also available at the following address:           */
%SRCG%L/* https://www.oorexx.org/license.html                                        */
%SRCG%L/*                                                                            */
%SRCG%L/*----------------------------------------------------------------------------*/
%SRCG%L
%SRCG%Ldo condition over .array~of('user zz', 'syntax 40.4')
%SRCG%L  do operand over .array~of('additional (.array~of(bad))', 'array (bad)')
%SRCG%L    do mode over .array~of('off', 'r', 'i')
%SRCG%L      say condition operand mode runCase(condition, operand, mode)
%SRCG%L    end
%SRCG%L  end
%SRCG%Lend
%SRCG%Lexit
%SRCG%L::routine runCase
%SRCG%Luse arg condition, operand, mode
%SRCG%Lsource = .array~of('signal on syntax name caught', 'bad = .Bad~new', 'trace 'mode, ,
%SRCG%L  'raise 'condition' 'operand' return "raised"', 'caught:', 'trace off', ,
%SRCG%L  "return condition('o')~code", '::class Bad', '::method defaultname', ,
%SRCG%L  'raise syntax 98.900 array("rendered")')
%SRCG%Lreturn .routine~new('raise-case', source)~call
