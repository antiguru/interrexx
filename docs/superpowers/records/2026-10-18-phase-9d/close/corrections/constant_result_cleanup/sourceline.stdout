%SRCG%L
%SRCG%Lsignal on syntax name caught
%SRCG%Lsrc = .array~of('say "prologue"', '::class c', '::constant k (self)', '::method defaultname class', 'raise syntax 98.900 array("boom")', '::options trace r')
%SRCG%Lp = .package~new('bad', src)
%SRCG%Lsay 'unexpected'
%SRCG%Lexit
%SRCG%Lcaught:
%SRCG%Ltrace off
%SRCG%Lsay 'caught' condition('o')~code
%SRCG%Lsay 'after'
%SRCG%Lexit
