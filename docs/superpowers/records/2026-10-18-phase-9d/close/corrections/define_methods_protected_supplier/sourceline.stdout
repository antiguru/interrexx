%SRCG%L
%SRCG%Lsupplier = .directory~method('SUPPLIER')~copy
%SRCG%Lsupplier~setProtected
%SRCG%L.ProtectedCollection~define('SUPPLIER', supplier)
%SRCG%Lmanager = .Manager~new
%SRCG%L.context~package~setSecurityManager(manager)
%SRCG%Lcall install .ProtectedCollection~new
%SRCG%Lsay 'installed' .Target~new~m
%SRCG%Lexit
%SRCG%L::routine install
%SRCG%Luse arg methods
%SRCG%L.Target~defineMethods(methods)
%SRCG%L::class Target
%SRCG%L::class ProtectedCollection subclass Directory
%SRCG%L::class Manager
%SRCG%L::method unknown
%SRCG%Luse arg name, args
%SRCG%Lif name == 'METHOD', args[1]~name == 'SUPPLIER' then do
%SRCG%L  say 'supplier checkpoint'
%SRCG%L  args[1]~result = .supplier~new(.array~of('return 9'), .array~of('m'))
%SRCG%L  return 1
%SRCG%Lend
%SRCG%Lreturn 0
