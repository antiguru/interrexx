%SRCG%L
%SRCG%Lmanager = .Manager~new
%SRCG%L.context~package~setSecurityManager(manager)
%SRCG%Ltarget = .object~subclass('Target')
%SRCG%L.local~target = target
%SRCG%Lmethods = .Coll~new
%SRCG%Lmethods['outer'] = 'return 1'
%SRCG%Ltarget~defineMethods(methods)
%SRCG%Lsay 'events' manager~events~makeString(, '|')
%SRCG%Lsay 'installed' target~new~outer target~new~inner target~new~nested
%SRCG%Lplain = .directory~new
%SRCG%Lplain['plain'] = 'return 4'
%SRCG%Ltarget~defineMethods(plain)
%SRCG%Ltarget~defineMethods(.Protocol~new)
%SRCG%Lsay 'adjacent' target~new~plain target~new~protocol
%SRCG%Lexit
%SRCG%L::class Coll subclass Directory
%SRCG%L::method supplier
%SRCG%Lsay 'supplier'
%SRCG%L.local~target~define('inner', 'return 2')
%SRCG%L.local~target~defineMethods(self~nestedMethods)
%SRCG%Lreturn self~supplier:super
%SRCG%L::method nestedMethods
%SRCG%Lmethods = .directory~new
%SRCG%Lmethods['nested'] = 'return 3'
%SRCG%Lreturn methods
%SRCG%L::class Protocol
%SRCG%L::method supplier
%SRCG%Lreturn .supplier~new(.array~of('return 5'), .array~of('protocol'))
%SRCG%L::class Manager
%SRCG%L::method init
%SRCG%Lexpose events
%SRCG%Levents = .array~new
%SRCG%L::attribute events get
%SRCG%L::method unknown
%SRCG%Lexpose events
%SRCG%Luse arg name, args
%SRCG%Lif name == 'METHOD' then events~append(args[1]~name)
%SRCG%Lreturn 0
