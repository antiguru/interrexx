%SRCG%L
%SRCG%Lsignal on syntax name caught
%SRCG%Lcall raiser
%SRCG%Lsay 'after additional'
%SRCG%Lcall arrayraiser
%SRCG%Lsay 'after array'
%SRCG%Lexit
%SRCG%Lcaught:
%SRCG%Lsay 'caught' condition('o')~code
%SRCG%Lexit
%SRCG%Lraiser:
%SRCG%Lraise user zz additional (.array~of(.bad~new)) return
%SRCG%Larrayraiser:
%SRCG%Lraise user zz array (.bad~new) return
%SRCG%L::class bad
%SRCG%L::method defaultname
%SRCG%Lraise syntax 98.900 array('unwanted rendering')
