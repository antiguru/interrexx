# one of them, and the other waits on (PR 4 review M3).
program
s = SockSocket('AF_INET', 'SOCK_STREAM', 0)
a.family = 'AF_INET'; a.port = 0; a.addr = '127.0.0.1'
call SockBind s, 'a.'
call SockListen s, 5
call SockGetSockName s, 'a.'
r1 = .acceptor~new~start('take', s)
r2 = .acceptor~new~start('take', s)
call SysSleep 0.3
c1 = SockSocket('AF_INET', 'SOCK_STREAM', 0)
say 'first' SockConnect(c1, 'a.')
call SysSleep 0.3
c2 = SockSocket('AF_INET', 'SOCK_STREAM', 0)
say 'second' SockConnect(c2, 'a.')
say 'accepted' (r1~result > 0) (r2~result > 0)
::class acceptor
::method take
  use arg s
  return SockAccept(s)
::requires 'rxsock' LIBRARY
::requires 'rxunixsys' LIBRARY
----
rc 0
[stdout]
first 0
second 0
accepted 1 1
