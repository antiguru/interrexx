# Field splitting on the program's IFS, and tilde on its HOME: an `@NAME=value`
# line sets a variable (`@-NAME` removes it) for the next text.
program
do name over 'a.txt', 'b.txt', 'c d.txt', '.hidden', 'abc', '*star', 'sub/x.txt'
  call lineout name, ''
  call lineout name
end
call SysMkDir 'sub/deep'
call setup
do line over .resources~cases
  select
    when line~startsWith('@-') then call value line~substr(3), .nil, 'ENVIRONMENT'
    when line~startsWith('@') then do
      parse var line '@' name '=' val
      call value name, val, 'ENVIRONMENT'
    end
    otherwise
      call show line
      call setup
  end
end
exit
show: procedure
  use arg text
  w = SysWordexp(text)
  line = text '=>' w~items':'
  do word over w
    line = line'['word']'
  end
  wex = value('WEX', , 'ENVIRONMENT')
  if wex \== '' then line = line 'WEX='wex
  say line
  return
setup:
  call value 'WEX', .nil, 'ENVIRONMENT'
  call value 'IFS', .nil, 'ENVIRONMENT'
  call value 'V', .nil, 'ENVIRONMENT'
  call value 'W', .nil, 'ENVIRONMENT'
  do pair over 'SET=value', 'EMPTY=', 'SP=a  b c', 'PAT=abc.def.ghi', 'NUM=7', "Q=it's", 'STAR=*.txt', 'BS=a\b', 'HOME=/home/tester'
    parse var pair name '=' val
    call value name, val, 'ENVIRONMENT'
  end
  return
