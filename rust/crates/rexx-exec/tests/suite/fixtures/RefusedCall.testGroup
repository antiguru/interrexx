#!/usr/bin/env rexx
/* TEST_B sends a message this crate refuses. */
  parse source . . s
  group = .TestGroup~new(s)
  group~add(.RefusedCall.testGroup)
  if group~isAutomatedTest then return group
  testResult = group~suite~execute~~print
return testResult

::requires 'ooTest.frm'

::class "RefusedCall.testGroup" subclass ooTestCase public

::method test_a
  self~assertSame(1, 1)

::method test_b
  r = .CommandHandler~environments
  self~assertSame(1, 1)

::method test_c
  self~assertSame(1, 1)

::method test_d
  self~assertSame(1, 2)
