quiet_ = .output~destination(.stream~new('/dev/null'))
signal on syntax name raised_
/* `~addClass` sent to the package the primitive classes belong to.
   A different code from the class mutators' own lock, and a different
   message, so it is its own row. */
.Array~package~addClass("ZZ", .Array)

exit
raised_: c_ = condition('O'); .stdout~lineout(c_~code); do i_ = 1 to c_~additional~items; .stdout~lineout(i_ c_~additional[i_]); end
