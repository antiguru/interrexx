# do-blocks in a compiled body: plain, and as an IF's branches
run
a = 0; b = 0; c = 0
do i = 1 to 10000
  do
    a = a + i
    b = b + 1
  end
  if i // 2 = 0 then do
    c = c + 1
    a = a - 1
  end
  else do
    c = c - 1
    b = b + 2
  end
end
say a b c
