# quiet builtins in a compiled body: one call each, over argument registers,
# with no refresh
run
t = 0; s = 'the quick brown fox'
do i = 1 to 10000
  p = pos('o', s, i // 5 + 1); w = word(s, i // 4 + 1); u = substr(s, p, 3)
  t = t + length(w) + p + words(s) + wordpos('fox', s) + lastpos('o', s)
  v = translate(u, 'XY', 'ow') || reverse(w) || copies('-', 2) || strip('  a  ')
  t = t + length(v) + abs(-i // 3) + max(i // 7, 3) + min(i // 7, 3) + sign(-i)
  h = c2x(left(w, 2)) || x2c('41') || d2x(i // 256) || right(i, 3, 0) || center('m', 3)
  t = t + length(h) + verify(w, 'abcdefghijklmnopqrstuvwxyz') + countstr('o', s)
end
say t h v u
