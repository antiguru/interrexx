# an inner counted loop in a compiled body: its start and each pass boundary
# through the host, its body compiled. The outer body's own work is what
# passes the gate, so the outer loop compiles with the inner one in it
run
t = 0
do i = 1 to 10000
  p0 = i + 1; p1 = p0 - i; p2 = p1 // 3 * 2; p3 = p2 // 7; p4 = p3 + 5
  p5 = p4 - i; p6 = p5 // 3 * 2; p7 = p6 // 7; p8 = p7 + 9; p9 = p8 - i
  do j = 1 to 5
    t = t + i * j
    u = t // 7
  end
  t = t - u
end
say t i j p9
----
750045002 10001 6 -9991
compiled: lines 2, 5

