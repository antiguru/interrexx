# an unset compound read takes the full path, where the NOVALUE hook, the
# derived name and SIGNAL ON NOVALUE are
run
.local['NOVALUE'] = .hook~new
n = 0
do i = 1 to 10000
  k = i // 3
  if i > 9997 then n = n + length(u.k)
  else n = n + 1
end
say n
signal on novalue
do i = 1 to 10000
  if i = 9999 then n = n + w.i
  n = n + 1
end
exit
novalue:
  say 'novalue at line' sigl 'for' condition('D') 'i =' i 'n =' n
::class hook
::method novalue
  use arg name
  say 'hook asked for' name
  return .nil
