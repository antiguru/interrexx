# a tail whose value is an object is a string request, Rexx code, so the
# access takes the full path: MAKESTRING runs once per access, and the tail
# the object's rendering names is never the one read
run
a.ms = 'hit'; n = 0; o = .key~new
w = o~objectName; a.w = 'the rendering, not the string request'
do i = 1 to 10000
  j = i // 2
  a.j = i
  if i > 9997 then if i < 10000 then n = n + length(a.o)
  if i > 9997 then if i < 10000 then a.o = i
end
say n a.ms a.0 a.1
::class key
::method makestring
  say 'makestring asked'
  return 'MS'
::method string
  say 'string asked'
  return 'MS'
----
