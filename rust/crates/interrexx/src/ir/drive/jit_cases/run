line 4 error 40.14 at i = 9001 n = 18000
compiled: yes
quiet builtin calls: yes

# an object argument's STRING method is Rexx code, so a call over one takes
# the full path, at a site resolved before the compile: the method runs once
# per call, and its second call raises
run
o = .loud~new; n = 0
do i = 1 to 10000
  n = n + length(i)
  if i = 1 | i = 9500 then n = n + length(o)
end
say n
::class loud
::method string
  expose count
  if var('count') = 0 then count = 0
  count = count + 1
  say 'string asked' count
  if count = 2 then raise syntax 93.900 array('refused')
  return 'abc'
