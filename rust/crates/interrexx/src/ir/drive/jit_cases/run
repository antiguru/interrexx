# IF and ELSE, nested, with % and // of negative values
run
a = 0; b = 0; c = 0; d = 0
do i = -5000 to 5000
  if i // 3 = 0 then a = a + 1
  else if i // 3 = 1 then b = b + i % 7
  else c = c - 1
  if i >= 0 then if i \= 50 then d = d + 1
end
say a b c d
----
3333 594643 -5001 5000
compiled: line 2

# a SELECT whose branches run between native work
run
a = 0; b = 0; c = 0
do i = 1 to 10000
  x = i * 3 + 1; y = x - i; z = y * 2; w = z - x + i
  x = x + 1; y = y + 2; z = z + 3; w = w + 4
  x = x - 1; y = y - 2; z = z - 3; w = w - 4
  q = x + y; r = q - z; s = r + w; t = s - x
  select
    when i // 3 = 0 then a = a + 1
    when i // 3 = 1 then b = b + 1
    otherwise c = c + 1
  end
end
say a b c t
----
3333 3334 3333 0
compiled: line 2

# comma-list IF and WHEN short-circuit within the clause
run
a = 0; b = 0; c = 0; d = 0
do i = 1 to 10000
  x = i * 3 + 1; y = x - i; z = y * 2; w = z - x + i
  x = x + 1; y = y + 2; z = z + 3; w = w + 4
  x = x - 1; y = y - 2; z = z - 3; w = w - 4
  if i // 2 = 0, i > 5000 then a = a + 1
  else b = b + 1
  select
    when i // 2 = 1, i > 5000 then c = c + 1
    when 0, 2 then nop
    otherwise d = d + 1
  end
end
say a b c d
----
2500 7500 2500 7500
compiled: line 2

