# every quiet builtin in one compiled body, each call checked in debug against
# a full refresh of the block
run
t = 0; s = 'the quick brown fox'
do i = 1 to 10000
  t = t + abbrev('quick', 'qu') + abs(-3) + length(bitand('ab', 'cd')) + length(bitor('a', 'b'))
  t = t + length(bitxor('a', 'b')) + length(b2x('1010')) + length(center(s, 25))
  t = t + length(centre('x', 3)) + length(changestr('o', s, '0')) + compare(s, 'the')
  t = t + length(copies('ab', 3)) + countstr('o', s) + c2d('a') + length(c2x('ab'))
  t = t + length(delstr(s, 2, 3)) + length(delword(s, 2)) + length(d2c(65)) + length(d2x(255))
  t = t + length(format(1.5, 3, 2)) + length(insert('x', s, 3)) + lastpos('o', s)
  t = t + length(left(s, 5)) + length(lower(s)) + max(1, 7, 3) + min(4, 2) + length(overlay('x', s, 2))
  t = t + pos('fox', s) + length(reverse(s)) + length(right(s, 4)) + sign(-5) + length(space(s, 2))
  t = t + length(strip('  a  ')) + length(substr(s, 3, 4)) + length(subword(s, 2, 2))
  t = t + length(translate(s)) + length(trunc(3.75, 1)) + length(upper(s)) + verify(s, 'the ')
  t = t + length(word(s, 2)) + wordindex(s, 3) + wordlength(s, 4) + wordpos('fox', s) + words(s)
  t = t + length(xrange('a', 'f')) + length(x2b('a')) + length(x2c('41')) + x2d('ff')
end
say t
----
7050000
compiled: yes
quiet builtin calls: yes

# compound reads and writes in a compiled body, a shared read and write over a
