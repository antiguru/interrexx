# semaphore.rs: a mutex another activity holds; a refused acquire and one that
# times out. The holder signals once it owns the mutex and keeps it until main
# is done, so the outcome does not depend on scheduling.
program
m=.MutexSemaphore~new
ready=.EventSemaphore~new
done=.EventSemaphore~new
o=.holder~new
o~hold(m, ready, done)
ready~wait
call show m~acquire(0)
call show m~acquire(0.05)
done~post
exit
show: procedure
  use arg v
  h = v~identityHash
  if h == .true~identityHash then say 'true'
  else if h == .false~identityHash then say 'false'
  else say 'other'
  return
::class holder
::method hold
  use arg m, ready, done
  reply
  m~acquire
  ready~post
  done~wait
  m~release
