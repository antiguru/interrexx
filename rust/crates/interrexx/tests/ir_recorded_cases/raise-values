# ADDITIONAL is evaluated before RETURN and converted after it. A value with
# no array is 98.939, and an object's MAKEARRAY runs after RETURN's call.
program
signal on syntax
o = .noisy~new
call sub
exit
syntax: say 'trapped' condition('O')~code condition('O')~additional~items; call two; exit
f: say 'f' arg(1); return arg(1)
sub:
  raise syntax 40.1 additional (.nil) return (f('R'))
two:
  signal on syntax name t2
  raise syntax (o) description (f('D')) additional (o) return (f('R2'))
t2: say 't2' condition('O')~code condition('O')~additional[1]; return
::class noisy
::method string; say 'string sent'; return '40.1'
::method makearray; say 'makearray sent'; return .array~of('item')
----
rc> 0
out> f R
out> trapped 98.939 0
out> string sent
out> f D
out> f R2
out> makearray sent
out> t2 40.1 item

# A failure evaluating EXIT is reported before ADDITIONAL's array check.
program
signal on syntax
call sub
exit
syntax: say 'trapped' condition('O')~code; exit
sub:
  raise syntax 40.1 additional (f('A')) exit (f('E'))
f:
  say 'f' arg(1)
  if arg(1) = 'A' then return .nil
  zero = 0
  return 1 / zero
----
rc> 0
out> f A
out> f E
out> trapped 42.3

# RAISE PROPAGATE replaces DESCRIPTION, ADDITIONAL and RESULT
program
signal on syntax name top
call sub
exit
top: say 'top' condition('O')~code condition('D') condition('O')~additional,
       condition('O')~result
  exit
f: say 'f' arg(1); return arg(1)
sub:
  signal on syntax name local
  zero = 0
  say 1 / zero
  return
local:
  raise propagate description (f('newdesc')) additional (f('newadd')) return (f('R'))
----
rc> 0
out> f newdesc
out> f newadd
out> f R
out> top 42.3 newdesc newadd R

