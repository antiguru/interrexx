# a RAISE in a loop, its CALL ON handler run after each call
program
call on user u name h
n = 0
do i = 1 to 3
  call sub i
  n = n + result
end
say n
exit
h: say 'h' condition('D'); return
sub:
  raise user u description ('d' || arg(1)) return (arg(1) * 2)
----
rc> 0
out> h d1
out> h d2
out> h d3
out> 12
