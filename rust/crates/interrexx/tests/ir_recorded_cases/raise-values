# `RAISE` evaluates its expressions as native ops, each followed by the
# `Op::RaisePart` that does what the instruction does with that value before
# it evaluates the next, and `Op::ExecWith` raises from what the parts left.
# Each stanza answers what the walked expressions answered.

# DESCRIPTION, ADDITIONAL and RETURN, trapped by the caller's CALL ON
program
call on user u name h
call sub
say 'back' result
exit
h: say 'h' condition('C') condition('D') condition('A') condition('O')~result
  return
f: say 'f' arg(1); return arg(1)
sub:
  raise user u description (f('D')) additional (f('A')) return (f('R'))
----
rc> 0
out> f D
out> f A
out> f R
out> h USER U D A R
out> back R

# ARRAY with an omitted item, and EXIT from an internal call of a routine,
# which leaves the routine too
program
call on user u name h
call r
say 'main after' result
exit
h: say 'h' condition('A')~items condition('A')[1] condition('A')~hasindex(2),
     condition('A')[3] condition('O')~result
  return
::routine r
  call inner
  say 'r after'
  return 'r'
inner:
  raise user u array ((f(1)), , (f(3))) exit (f('E'))
f: say 'f' arg(1); return arg(1)
----
rc> 0
out> f 1
out> f 3
out> f E
out> h 2 1 0 3 E
out> main after E

# the fixed order whatever the order written: the code, DESCRIPTION,
# ADDITIONAL, then RETURN
program
call on error name h
call sub
say 'back' result
exit
h: say 'h' rc condition('D') condition('A') condition('O')~rc; return
f: say 'f' arg(1); return arg(1)
sub:
  raise error (f(7)) return (f('R')) additional (f('A')) description (f('D'))
----
rc> 0
out> f 7
out> f D
out> f A
out> f R
out> h 7 D A 7
out> back R

# a SYNTAX number from a call, with ARRAY substitutions, trapped
program
signal on syntax
call sub
exit
syntax: say 'trapped' condition('O')~code condition('D') condition('O')~additional~items,
          condition('O')~result
  exit
f: say 'f' arg(1); return arg(1)
sub:
  raise syntax (f('40.21')) description (f('D')) array ((f('A1')), 'two') return (f('R'))
----
rc> 0
out> f 40.21
out> f D
out> f A1
out> f R
out> trapped 40.21 D 2 R

