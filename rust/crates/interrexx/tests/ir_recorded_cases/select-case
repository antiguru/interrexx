# A `SELECT CASE` expression runs as native ops, filed by `Op::SelectCase`.
# Each stanza answers what the walked expression answered.

# trace i: the expression's intermediates, then the `>K>` line
program
trace i
s = 'abc'
select case length(s) + 1
  when 4 then say 'four'
  otherwise say 'other'
end
----
rc> 0
out> four
err>      2 *-* s = 'abc'
err>        >L>   "abc"
err>        >>>   "abc"
err>        >=>   S <= "abc"
err>      3 *-* select case length(s) + 1
err>        >V>   S => "abc"
err>        >A>   "abc"
err>        >F>   LENGTH => "3"
err>        >L>   "1"
err>        >O>   "+" => "4"
err>        >K>   "CASE" => "4"
err>      4 *-*   when 4 
err>        >L>     "4"
err>        >>>     "4"
err>        >>>     "1"
err>      4 *-*     then
err>      4 *-*       say 'four'
err>        >L>         "four"
err>        >>>         "four"

# trace r: only the `>K>` line
program
trace r
o = .array~of(1, 2)
select case o~items
  when 2 then say 'two'
  otherwise nop
end
----
rc> 0
out> two
err>      2 *-* o = .array~of(1, 2)
err>        >>>   "an Array"
err>      3 *-* select case o~items
