# a CALL ON handler queued by the expression runs at the SELECT's boundary,
# inside the block
program
call on user zz name h
select case g()
  when 1 then say 'one'
end
say 'after'
exit
g: raise user zz return 1
h:
say 'handler' sigl
return
----
rc> 0
out> handler 2
out> one
out> after

