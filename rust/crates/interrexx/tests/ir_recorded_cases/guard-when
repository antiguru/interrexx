# NOVALUE raised in the condition, trapped and not
program
o = .g~new
say o~m
say o~k
::class g
::method m
  expose v
  signal on novalue
  drop v
  guard on when v = 1
  return 'no'
novalue: return 'novalue' condition('d') sigl
::method k
  expose v
  drop v
  guard on when v = 'V'
  return 'k' v
----
rc> 0
out> novalue V 9
out> k V

# a syntax error in the condition, trapped by the caller
