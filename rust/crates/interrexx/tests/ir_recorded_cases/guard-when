# A `GUARD ... WHEN` of reads and operators runs its condition from the
# side table on every test, the first and each one after a wake. Each
# stanza answers what the walked condition answered.

# a condition true at once, under trace r
program
say .g~new~m
::class g
::method init
  expose n
  n = 2
::method m
  expose n
  trace r
  guard on when n * 2 = 4 & n > 1
  return n
----
rc> 0
out> 2
err>        >I>
err>      9 *-* guard on when n * 2 = 4 & n > 1
err>        >K>   "WHEN" => "1"
err>     10 *-* return n
err>        >>>   "2"
err>        <I<

# trace i: the condition's intermediates
program
say .g~new~m
::class g
::method init
  expose n s.
  n = 2; s.2 = 'x'
::method m
  expose n s.
  trace i
  guard off when s.n == 'x'
  return n
----
rc> 0
out> 2
err>        >I>
err>      9 *-* guard off when s.n == 'x'
err>        >C>   S.N => "S.2"
err>        >V>   S.N => "x"
err>        >L>   "x"
err>        >O>   "==" => "1"
err>        >K>   "WHEN" => "1"
err>     10 *-* return n
err>        >V>   N => "2"
err>        >>>   "2"
err>        <I<

