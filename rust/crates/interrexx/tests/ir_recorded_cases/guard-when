# a condition false at first, retested after each store until it holds
program
o = .pp~new
o~start('pong')
do i = 1 to 5
  o~ping(i)
end
say o~last
::class pp
::method init
  expose turn last
  turn = 0; last = 0
::method ping
  expose turn last
  use arg i
  guard on when turn = 0
  last = i; turn = 1
::method pong
  expose turn last
  do 5
    guard on when turn = 1 & last > 0
    turn = 0
  end
::method last
  expose turn last
  guard on when turn = 0
  return last
----
rc> 0
out> 5

# a reference argument names the exposed variable the condition watches
program
say .g~new~m
::class g
::method init
  expose x
  x = 1
::method m
  expose x
  guard on when check(>x)
  return 'passed'
::routine check
  use arg r
  return r~value = 1
----
rc> 0
out> passed
