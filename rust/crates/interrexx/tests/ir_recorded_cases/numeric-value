# `NUMERIC DIGITS|FUZZ|FORM VALUE expr` evaluates its expression as native
# ops, and `Op::ExecValue` does the rest. Each stanza answers what the walked
# expression answered.

# trace i: the expression's intermediates, then the `>K>` line
program
trace i
d = 5
numeric digits d + 1
numeric fuzz f()
numeric form value g()
say digits() fuzz() form()
exit
f: return 2
g: return 'ENGINEERING'
----
rc> 0
out> 6 2 ENGINEERING
err>      2 *-* d = 5
err>        >L>   "5"
err>        >>>   "5"
err>        >=>   D <= "5"
err>      3 *-* numeric digits d + 1
err>        >V>   D => "5"
err>        >L>   "1"
err>        >O>   "+" => "6"
err>        >K>   "DIGITS" => "6"
err>      4 *-* numeric fuzz f()
err>      8 *-*   f:
err>      8 *-*   return 2
err>        >L>     "2"
err>        >>>     "2"
err>        >F>   F => "2"
err>        >K>   "FUZZ" => "2"
err>      5 *-* numeric form value g()
err>      9 *-*   g:
err>      9 *-*   return 'ENGINEERING'
err>        >L>     "ENGINEERING"
err>        >>>     "ENGINEERING"
err>        >F>   G => "ENGINEERING"
err>        >K>   "FORM" => "ENGINEERING"
err>      6 *-* say digits() fuzz() form()
err>        >F>   DIGITS => "6"
err>        >F>   FUZZ => "2"
err>        >O>   " " => "6 2"
err>        >F>   FORM => "ENGINEERING"
err>        >O>   " " => "6 2 ENGINEERING"
err>        >>>   "6 2 ENGINEERING"
err>      7 *-* exit

