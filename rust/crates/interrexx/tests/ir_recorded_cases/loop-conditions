# an UNTIL or WHILE that calls or sends, in a loop with a COUNTER, with and
# without a control variable: every pass advances and counts
program
k = 0
do counter c i = 1 to 3 until f(i)
  k = k + 1; if k > 9 then leave
  say i c
end
say 'after' i c
do counter c 3 until f(0)
  k = k + 1; if k > 19 then leave
  say c
end
say 'after' c
o = .c~new
do counter c j = 1 to 2 until o~no
  k = k + 1; if k > 29 then leave
  say j c
end
say 'after' j c
do counter c i = 1 to 3 while f(i) = 0
  say i c
end
say 'after' i c
do counter c 2 while o~no = 0
  say c
end
say 'after' c
exit
f: return 0
