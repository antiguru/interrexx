# a USER condition the sent method raises is not the caller's to trap, so it
# ends the program as 91.999, blamed on the END whose test sent it
program
call on user zz name h
o = .c~new
do while o~more
  say 'pass'
end
say 'after'
exit
h:
say 'handler' sigl
return
