# RESULT dropped when the callee returns nothing, kept when it returns a value
program
result = 'before'
call (zn) 1
say 'after a bare return' result symbol('RESULT')
call (zn) 2
say 'after a value' result
exit
zn: if arg(1) = 1 then return; return 'v'
