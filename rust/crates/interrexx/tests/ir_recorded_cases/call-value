# a CALL (expr) in a loop, under a CALL ON trap that the callee raises
program
call on user u name zh
do zi = 1 to 3
  call ('Z' || zi) zi
  say 'back' zi result
end
exit
zh: say 'zh' condition('c'); return
Z1: return 'one'
Z2: raise user u return 'two'
Z3: return
