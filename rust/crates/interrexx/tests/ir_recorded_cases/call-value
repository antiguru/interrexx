out> label 3
out> label 6
out> label 9
out> builtin 4
out> routine 21

# the name is not upcased: a mixed-case label name misses the label, and the
# routine search after it finds nothing
program
signal on syntax name zs
call ('Zsub') zf(1)
say 'not reached'
exit
zsub: return 'sub'
zf: say 'f' arg(1); return arg(1)
zs: say 'syntax' condition('o')~code
