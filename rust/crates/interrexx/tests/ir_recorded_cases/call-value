# the target is evaluated before the arguments, and its string conversion
# (a MAKESTRING method) comes between the two
program
call (zf('ZSUB')) zf(1), zf(2)
say 'result' result
call (.k~new) zf(3)
say 'result' result
exit
zf: say 'f' arg(1); return arg(1)
zsub: return arg(1) arg(2) arg()
::class k
::method makestring
  say 'makestring'
  return 'ZSUB'
