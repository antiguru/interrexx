# `CALL (expr)` evaluates its target as native ops, then `Op::ExecValue`
# takes the name from the value and traces it, the arguments run as ops of
# their own, and `Op::CallNamed` resolves the name and calls it. Each stanza
# answers what the walked instruction answered.

# an internal label, a builtin and a package routine, each by a computed name
program
zn = 'ZSUB'
do zi = 1 to 3
  call (zn) zi, zi * 2
  say 'label' result
end
call ('LEN' || 'GTH') 'abcd'
say 'builtin' result
call (zr()) 7
say 'routine' result
exit
zsub: use arg za, zb; return za + zb
zr: return 'ZROUT'
::routine zrout
  use arg zv
  return zv * 3
----
