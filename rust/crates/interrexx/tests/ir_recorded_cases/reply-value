# outside a method the refusal comes before the expression, whose call does
# not run
program
say .c~new~n
::class c
::method n
  call sub
  return 'n end'
sub:
  reply f()
  return
::routine f
  say 'f ran'
  return 1
----
rc> 157
err>      7 *-*   reply f()
err>      4 *-* call sub
err>      1 *-* say .c~new~n
err> Error 99 running /nonexistent/ir-dual-case.rex line 7:
