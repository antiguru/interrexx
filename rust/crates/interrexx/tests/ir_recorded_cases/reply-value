# `REPLY expr` evaluates its expression as native ops behind `Op::ExecCheck`,
# and `Op::ExecWith` replies from the value: the `>>>` line, the check for a
# second `REPLY` and the split. Each stanza answers what the walked
# expression answered.

# a literal, a variable and a call, under trace r; the caller uses each
# value while the method goes on
program
o = .c~new
say o~m(4)
say o~done
::class c
::method done
  return 'done'
::method m
  trace r
  use arg n
  reply n * 2 || '/' || f(n) || '/' || 'lit'
  say 'tail' n
  return
::routine f
  return arg(1) + 1
----
rc> 0
out> 8/5/lit
out> tail 4
out> done
err>        >I>
err>      9 *-* use arg n
err>        >>>   "4"
err>     10 *-* reply n * 2 || '/' || f(n) || '/' || 'lit'
err>        >>>   "8/5/lit"
err>        <I<
err>        >I>
err>     11 *-* say 'tail' n
err>        >>>   "tail 4"
err>     12 *-* return
err>        <I<

# trace i: the expression's intermediates
program
o = .c~new
say o~m(3)
say o~done
::class c
::method done
  return 'done'
::method m
  trace i
  use arg n
  s.3 = 'x'
  reply s.n || (n + 1) f(n)
  say 'tail'
::routine f
  return 'f' || arg(1)
----
rc> 0
out> x4 f3
out> tail
out> done
err>        >I>
err>      9 *-* use arg n
err>        >>>   "3"
err>        >=>   N <= "3"
err>     10 *-* s.3 = 'x'
err>        >L>   "x"
err>        >>>   "x"
err>        >C>   S.3 => "S.3"
err>        >=>   S.3 <= "x"
err>     11 *-* reply s.n || (n + 1) f(n)
err>        >C>   S.N => "S.3"
err>        >V>   S.N => "x"
err>        >V>   N => "3"
err>        >L>   "1"
err>        >O>   "+" => "4"
err>        >O>   "||" => "x4"
err>        >V>   N => "3"
err>        >A>   "3"
err>        >F>   F => "f3"
err>        >O>   " " => "x4 f3"
err>        >>>   "x4 f3"
err>        <I<
err>        >I>
err>     12 *-* say 'tail'
err>        >L>   "tail"
err>        >>>   "tail"
err>        <I<

# NOVALUE in the expression, trapped by SIGNAL ON and not
program
o = .c~new
say o~m
say o~k
say o~done
::class c
::method done
  return 'done'
::method m
  signal on novalue
  reply undefined_var + 1
  say 'tail'
  return
novalue:
  say 'trapped' condition('d')
  return 'from handler'
::method k
  trace r
  reply undefined_var
  say 'tail k'
----
rc> 0
out> trapped UNDEFINED_VAR
out> from handler
out> UNDEFINED_VAR
out> tail k
out> done
err>        >I>
err>     18 *-* reply undefined_var
err>        >>>   "UNDEFINED_VAR"
err>        <I<
err>        >I>
err>     19 *-* say 'tail k'
err>        >>>   "tail k"
err>        <I<

# an expression that raises before the reply, trapped by the caller
program
o = .c~new
signal on syntax
say o~m
exit
syntax: say 'caller trapped' condition('c') rc; exit 0
::class c
::method m
  trace r
  reply 1 + 'abc'
  say 'tail'
----
rc> 0
out> caller trapped SYNTAX 41
err>        >I>
err>      9 *-* reply 1 + 'abc'
err>        <I<

