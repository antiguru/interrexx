# the replied object is the one the method goes on changing
program
o = .c~new
r = o~m
say r~string
say o~done
say r~v
::class c
::method done
  return 'done'
::method m
  t = .t~new
  reply t
  t~v = 'changed after reply'
::class t
::attribute v
::method init
  expose v
  v = 'init'
::method string
  return 'a T'
----
rc> 0
out> a T
out> done
out> changed after reply

# a NOTREADY the expression raises runs its CALL ON handler at the clause's
# end, before the method goes on
program
o = .c~new
say o~m
say o~done
::class c
::method done
  return 'done'
::method m
  trace r
  call on notready name nr
  reply 'v:' linein('/nonexistent/dir/file')
  say 'tail'
  return
nr:
  say 'handler' condition('c')
  return
----
rc> 0
out> handler NOTREADY
out> v: 
out> tail
out> done
err>        >I>
err>      9 *-* call on notready name nr
err>     10 *-* reply 'v:' linein('/nonexistent/dir/file')
err>        >>>   "v: "
err>     13 *-*   nr:
err>     14 *-*   say 'handler' condition('c')
err>        >>>     "handler NOTREADY"
err>     15 *-*   return
err>        <I<
err>        >I>
err>     11 *-* say 'tail'
err>        >>>   "tail"
err>     12 *-* return
err>        <I<

