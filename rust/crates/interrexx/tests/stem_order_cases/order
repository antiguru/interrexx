# The order a stem lists its tails in is assignment order, not the order of
# their names. The expected blocks follow from `r[class.stem.deviation.1]`.

# allIndexes, allItems, makeArray and supplier follow assignment order
program
s.c = 1; s.b = 2; s.a = 3
say s.~allIndexes~makeArray~toString('l', ' ')
say s.~allItems~makeArray~toString('l', ' ')
say s.~makeArray~toString('l', ' ')
sup = s.~supplier
do while sup~available
  say sup~index sup~item
  sup~next
end
----
C B A
1 2 3
C B A
C 1
B 2
A 3

# DO OVER follows assignment order, and a tail that is neither shortest nor
# alphabetically first still comes where it was assigned
program
s.zz = 1; s.a = 2; s.mmm = 3; s.b = 4
do i over s.
  say i
end
----
ZZ
A
MMM
B

# assigning an existing tail again keeps its place
program
s.c = 1; s.b = 2; s.a = 3
s.c = 9
say s.~allIndexes~makeArray~toString('l', ' ')
----
C B A

# a dropped tail is not listed, and one assigned again after a drop goes to
# the end
program
s.c = 1; s.b = 2; s.a = 3
drop s.b
say s.~allIndexes~makeArray~toString('l', ' ')
s.b = 4
say s.~allIndexes~makeArray~toString('l', ' ')
say s.~items
----
C A
C A B
3

# index and removeItem choose the first match in assignment order
program
s.c = 'dup'; s.b = 'dup'; s.a = 'dup'
say s.~index('dup')
say s.~removeItem('dup')
say s.~allIndexes~makeArray~toString('l', ' ')
----
C
dup
B A

# hasItem and removeItem over a stem whose first match was dropped and
# assigned again: the match is the earlier remaining tail
program
s.c = 'dup'; s.b = 'dup'; s.a = 'dup'
drop s.c
s.c = 'dup'
say s.~index('dup')
say s.~removeItem('dup')
say s.~allIndexes~makeArray~toString('l', ' ')
----
B
dup
A C

# FORWARD ARGUMENTS with a stem passes the tails in assignment order
program
say .K~new~go
::class K
::method go
  s.c = 1; s.b = 2; s.a = 3
  forward message('SEEN') arguments (s.)
::method seen
  r = ''
  do i = 1 to arg()
    r = r arg(i)
  end
  return strip(r)
----
C B A
