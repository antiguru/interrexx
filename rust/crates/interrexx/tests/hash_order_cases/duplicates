::method hashCode
  expose v
  return v~hashCode
::method '=='
  expose v
  use arg other
  return v == other~v
----
at first first
allAt first second third
supplier first second third
remove first items 2
removeItem second items 1
at third

# index and removeItem choose the oldest entry holding an item
program
r = .relation~new
r~put(.item~new('first'), 'b'); r~put(.item~new('other', 'w'), 'a')
r~put(.item~new('second'), 'a')
v = .item~new('probe')
say 'relation index' r~index(v)
say 'relation removeItem' r~removeItem(v)~tag 'allIndex' r~allIndex(v)~toString('l', ' ')
r~put(.item~new('third'), 'a')
say 'relation removeItem(v, a)' r~removeItem(v, 'a')~tag 'left' r~at('a')~tag r~allAt('a')~lastItem~tag
t = .table~new
t['y'] = .item~new('first'); t['x'] = .item~new('second')
say 'table index' t~index(v)
say 'table removeItem' t~removeItem(v)~tag 'left' t~allIndexes~toString('l', ' ')
