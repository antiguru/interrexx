# Where several entries share an index (`Relation`, `Bag`) they come out
# oldest first, and `at`, `[]`, `remove`, `allAt` and `supplier(index)` act
# on or start from the oldest. Where several entries hold an item,
# `index(item)` and `removeItem(item)` choose the first in insertion order.
# The expected blocks follow from those rules alone.

# a Relation's duplicates answer oldest first, and remove takes the oldest
program
r = .relation~new
r~put(1, 'k'); r~put(9, 'j'); r~put(2, 'k'); r~put(3, 'k')
say 'at' r~at('k') r['k']
say 'allAt' r~allAt('k')~toString('l', ' ')
s = r~supplier('k'); line = ''
do while s~available; line = line s~index'='s~item; s~next; end
say 'supplier'line
say 'remove' r~remove('k') 'allAt' r~allAt('k')~toString('l', ' ')
say 'remove' r~remove('k') 'allAt' r~allAt('k')~toString('l', ' ')
----
at 1 1
allAt 1 2 3
supplier k=1 k=2 k=3
remove 1 allAt 2 3
remove 2 allAt 3

# a Bag's equal items answer oldest first, and remove takes the oldest
program
b = .bag~new
b~put(.key~new('k', 'first')); b~put(.key~new('j', 'other'))
b~put(.key~new('k', 'second')); b~put(.key~new('k', 'third'))
k = .key~new('k', 'probe')
say 'at' b~at(k)~tag b[k]~tag
line = ''; do held over b~allAt(k); line = line held~tag; end
say 'allAt'line
s = b~supplier(k); line = ''
do while s~available; line = line s~item~tag; s~next; end
say 'supplier'line
say 'remove' b~remove(k)~tag 'items' b~items(k)
say 'removeItem' b~removeItem(k)~tag 'items' b~items(k)
say 'at' b~at(k)~tag
