# a copy lists its source's order, and later puts and removals to the copy
# and to the source each keep their own order
program
keys = .array~of('q', 'zz', 'b', 'k7', 'a', 'mm', 'x')
do cls over .array~of(.directory, .stringtable, .table, .identitytable, .set)
  t = cls~new
  do i = 1 to 5
    call put t, keys[i], i
  end
  t~remove(keys[2])
  u = t~copy
  say cls~id 'copy:  ' u~allIndexes~toString('l', ' ')
  call put t, keys[6], 6
  call put u, keys[7], 7
  u~remove(keys[1])
  call put u, keys[2], 2
  say cls~id 'source:' t~allIndexes~toString('l', ' ') t~hasIndex(keys[7]) t~hasIndex(keys[1])
  say cls~id 'copy:  ' u~allIndexes~toString('l', ' ') u~hasIndex(keys[6]) u~hasIndex(keys[1])
end
