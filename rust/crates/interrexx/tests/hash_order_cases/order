# the order survives growth past ten thousand entries
program
n = 12000
keys = .array~new(n)
do i = 1 to n
  keys[i] = 'k'i
end
do cls over .array~of(.directory, .stringtable, .table, .identitytable, .set)
  t = cls~new
  do i = 1 to n
    call put t, keys[i], i
  end
  indexes = t~allIndexes
  items = t~allItems
  bad = 0
  do i = 1 to n
    if indexes[i] \== keys[i] then bad = bad + 1
  end
  say cls~id t~items indexes~items bad indexes[1] indexes[n] items[1] items[n]
end
::routine put
  use arg t, k, v
  if t~isA(.set) then t~put(k)
  else t~put(v, k)
