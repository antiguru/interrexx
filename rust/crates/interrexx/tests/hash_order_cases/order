# an index put again after its removal goes to the end, and a put that
# replaces an existing index's item keeps its place
program
keys = .array~of('q', 'zz', 'b', 'k7', 'a', 'mm')
do cls over .array~of(.directory, .stringtable, .table, .identitytable, .set)
  t = cls~new
  do i = 1 to keys~items
    call put t, keys[i], i
  end
  t~remove(keys[3])
  call put t, keys[3], 'again'
  call put t, keys[1], 'new'
  say cls~id':' t~allIndexes~toString('l', ' ')
  say cls~id':' t~allItems~toString('l', ' ')
end
::routine put
  use arg t, k, v
  if t~isA(.set) then t~put(k)
  else t~put(v, k)
