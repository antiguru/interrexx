# the order survives churn that removes far more entries than it keeps
program
n = 3000
keys = .array~new(n)
do i = 1 to n
  keys[i] = 'n'i
end
fixed = .array~of('c', 'a', 'b')
do cls over .array~of(.directory, .stringtable, .table, .identitytable, .set)
  t = cls~new
  do i = 1 to fixed~items
    call put t, fixed[i], i
  end
  do i = 1 to n
    call put t, keys[i], i
    if i > 2 then t~remove(keys[i - 2])
  end
  t~remove(fixed[2])
  call put t, fixed[2], 'back'
  say cls~id t~items':' t~allIndexes~toString('l', ' ')
end
