# a Directory lists its contents, then its setMethod names, each in insertion
# order
program
d = .directory~new
d~setMethod('ZM', 'return 1')
d['zz'] = 1
d~setMethod('AM', 'return 2')
d['bb'] = 2
d~setMethod('MM', 'return 3')
d['aa'] = 3
d~setMethod('BM', 'return 4')
say d~allIndexes~toString('l', ' ')
say d~allItems~toString('l', ' ')
d~unsetMethod('ZM')
d~setMethod('ZM', 'return 5')
say d~allIndexes~toString('l', ' ')
----
zz bb aa ZM AM MM BM
1 2 3 1 2 3 4
zz bb aa AM MM BM ZM

# the capacity given to new is a sizing hint and does not change the order
program
keys = .array~of('q', 'zz', 'b', 'k7', 'a', 'mm', 'x', 'c1', 'p', 'e', 'ab', 'z')
do cls over .array~of(.directory, .stringtable, .table, .identitytable, .set)
  t = cls~new
  u = cls~new(1000)
  do i = 1 to keys~items
    call put t, keys[i], i
    call put u, keys[i], i
  end
  say cls~id':' t~allIndexes~toString('l', ' ')
  say cls~id':' u~allIndexes~toString('l', ' ')
end
