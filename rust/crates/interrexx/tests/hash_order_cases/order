# The order a mapped collection lists its entries in is the order their
# indexes were first put. The expected blocks follow from that rule alone.
# Each program runs the rule over `Directory`, `StringTable`, `Table`,
# `IdentityTable` and `Set`; a `Set`'s item is its index. Keys are held in an
# array, so an `IdentityTable` is given the same object every time.

# allIndexes, allItems, makeArray, supplier and DO OVER follow insertion order
program
keys = .array~of('q', 'zz', 'b', 'k7', 'a', 'mm', 'x', 'c1', 'p', 'e', 'ab', 'z')
do cls over .array~of(.directory, .stringtable, .table, .identitytable, .set)
  t = cls~new
  do i = 1 to keys~items
    call put t, keys[i], i
  end
  say cls~id
  say '  allIndexes' t~allIndexes~toString('l', ' ')
  say '  allItems  ' t~allItems~toString('l', ' ')
  say '  makeArray ' t~makeArray~toString('l', ' ')
  line = ''
  sup = t~supplier
  do while sup~available
    line = line sup~index'='sup~item
    sup~next
  end
  say '  supplier  'line
  line = ''
  do i over t
    line = line i
  end
  say '  do over   'line
end
::routine put
  use arg t, k, v
  if t~isA(.set) then t~put(k)
  else t~put(v, k)
