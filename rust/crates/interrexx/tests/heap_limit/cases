# Raised again once the heap, still held, grows on past where it was raised.

run limit=64M
count = 0
s = 'x'
call grow
call grow
say 'raised' count
exit
grow:
  signal on syntax
  do 40
    s = s || s
  end
  return
syntax:
  count = count + 1
  return
----
raised 2
rc=0

# Garbage never counts: a run that makes and drops far more than the limit is
# not refused.

run limit=64M
do 1000
  s = copies('z', 1000000)
end
say 'done' length(s)
----
done 1000000
rc=0

# A handler that lets go of what it held re-arms the limit: a later growth
# that passes it raises again, though far short of where it was raised first.

run limit=64M
signal on syntax
s = 'x'
do 40
  s = s || s
end
exit
syntax:
s = ''
say 'first' condition('o')~code
signal on syntax name second
a = .Array~new
do i = 1 to 1000
  a[i] = copies('s', 1000000)
end
say 'no error'
exit
second:
say 'second' condition('o')~code (a~items < 200)
----
first 5.0
second 5.0 1
rc=0

# The limit paces the collections from the start of the run: a clause that
# passes a limit far below the collector's own first step is raised.

run limit=1M
signal on syntax
t = copies('x', 900000) || copies('x', 900000)
say 'no error'
exit
syntax:
say 'trapped' condition('o')~code
----
trapped 5.0
rc=0

# A raise still owed when the clause that turned interactive tracing on ends
# is raised at that clause's end.

run limit=1M
signal on syntax
t = trace('?N') || copies('x', 900000) || copies('x', 900000)
say 'no error'
exit
syntax:
say 'trapped' condition('o')~code
----
trapped 5.0
rc=0

# A string sized by a number the program gives is refused where it is asked
# for, before the clause assigns it: `S` is never set.

run limit=64M
call try "substr('x', 1, 100000000)"
call try "insert('a', 'b', 100000000)"
call try "overlay('a', 'b', 100000000)"
call try "space('a b', 100000000)"
call try "format(1, 100000000)"
call try "trunc(1, 100000000)"
call try "'x'~substr(1, 100000000)"
call try "'b'~insert('a', 100000000)"
call try "'b'~overlay('a', 100000000)"
call try "'a b'~space(100000000)"
call try "'x'~replaceAt('y', 100000000)"
call try ".MutableBuffer~new('x')~substr(1, 100000000)"
exit
try:
  drop s
  signal on syntax
  interpret 's =' arg(1)
  say 'not refused' arg(1)
  return
syntax:
  say condition('o')~code symbol('S') arg(1)
  return
