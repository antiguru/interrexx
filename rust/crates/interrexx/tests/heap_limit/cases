# A clause that passes the limit and then fails with a condition of its own
# raises only that condition: the handler that traps it runs.

run limit=64M
signal on syntax
s = copies('x', 40000000)
t = s || s || nosuch()
say 'no error'
exit
syntax:
say 'trapped' condition('o')~code
s = ''
say 'continued'
----
trapped 43.1
continued
rc=0

# A limit below what the interpreter's own library holds raises nothing in
