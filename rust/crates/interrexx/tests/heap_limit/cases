# A request larger than the limit alone is refused where it is made, on every
# path that sizes an array, a buffer or a string from a program's number.

run limit=64M
call try ".Array~new(10000000)"
call try ".Array~new(10000, 1000)"
call try ".Array~new~insert('z', 10000000)"
call try ".Array~of('p')~put('z', 10000000)"
call try "a = .Array~of('p'); a[10000000] = 'z'"
call try ".MutableBuffer~new('', 100000000)"
call try "b = .MutableBuffer~new('x'); b~insert('y', 100000000)"
call try "b = .MutableBuffer~new('x'); b~overlay('y', 100000000)"
call try "a = .Array~new(1, 1); a[10000, 1000] = 'z'"
call try "s = copies('x', 100000000)"
exit
try:
  parse arg expression
  signal on syntax name failed
  interpret expression
  say expression 'raised nothing'
  return
failed:
  say expression condition('o')~code
  return
----
.Array~new(10000000) 5.0
.Array~new(10000, 1000) 5.0
.Array~new~insert('z', 10000000) 5.0
.Array~of('p')~put('z', 10000000) 5.0
a = .Array~of('p'); a[10000000] = 'z' 5.0
.MutableBuffer~new('', 100000000) 5.0
b = .MutableBuffer~new('x'); b~insert('y', 100000000) 5.0
b = .MutableBuffer~new('x'); b~overlay('y', 100000000) 5.0
a = .Array~new(1, 1); a[10000, 1000] = 'z' 5.0
s = copies('x', 100000000) 5.0
rc=0

