# Memory that passes the limit inside a method the interpreter's library
# writes in Rexx is raised at the end of the program's clause that sent it,
# not inside the library. Each pass adds a slot per item, so the passes cross
# the limit whatever a slot's size.

run limit=4M
b = .Array~new(10000)~fill(1)
a = .Array~new
do 1000
  a~appendAll(b)
end
say 'no error'
