# Growth across many requests is raised at the end of a clause, and the
# handler runs: it can let go of what the program holds and go on.

run limit=64M
signal on syntax
s = 'x'
do 40
  s = s || s
end
say 'no error'
exit
syntax:
say 'trapped' condition('o')~code
s = ''
say 'continued' length(copies('y', 1000))
----
trapped 5.0
continued 1000
rc=0

# Untrapped, it ends the program with error 5.

run limit=64M
a = .Array~new
do i = 1 to 100000000
  a[i] = i
end
say 'no error'
