# Users and groups: root is uid 0 and gid 0 everywhere; the rest is the host's user database
# (`docs/design/decisions.md`).
eval
SysGetpwnam('', 'n')
SysGetpwnam('root', '')
SysGetpwnam('root', 'x')
SysGetpwnam('nosuchuserq', 'x')
SysGetpwnam('nosuchuserq', 'n')
SysGetpwnam('root', 'n')
SysGetpwnam('root', 'Name')
SysGetpwnam('root', 'u')
SysGetpwnam('root', 'g')
SysGetpwnam('root', 'd')
SysGetpwnam('root', 'p')
SysGetpwuid(0, 'n')
SysGetpwuid(0, 'user')
SysGetpwuid(0, 'group')
SysGetpwuid(-5, 'n')
SysGetpwuid(-1, 'q')
SysGetpwuid(0, '')
SysGetpwuid(0, 'q')
SysGetgrnam('root', 'n')
SysGetgrnam('root', 'g')
SysGetgrnam('root', 'p')
SysGetgrnam('root', 'm')~class
SysGetgrnam('root', 'q')
SysGetgrnam('nosuchgroupq', 'q')
SysGetgrnam('', 'n')
SysGetgrnam('root', '')
SysGetgrgid(0, 'n')
SysGetgrgid(0, 'GROUP')
SysGetgrgid(0, 'pw')
SysGetgrgid(0, '')
SysGetgrgid(0, 'z')
SysGetgrgid(2147483646, 'q')
