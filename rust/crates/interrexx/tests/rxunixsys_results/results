# Deviation 90: SysWordexp is refused. It stays registered (RxFuncQuery
# answers 0 once RxFuncAdd has registered it, as on the oracle), and every call raises the routine failure,
# whose description says why: the PR 4 review's input, a plain pattern, a
# command substitution of each form, plain words, empty text and no argument
# alike. Nothing runs: the review's input and the substitutions would each
# make a file, and none exists after.
ruled
call RxFuncAdd 'SysWordexp', 'rxunixsys', 'SysWordexp'
say RxFuncQuery('SysWordexp')
do text over '"${x-''}"; touch made1; "''}"', '*', '$(touch made2)', '`touch made3`', 'a b', ''
  say try(text)
end
signal on syntax name none
call SysWordexp
none: say condition('o')~code condition('d')
made = 0
do n = 1 to 3
  if stream('made'n, 'c', 'query exists') \== '' then made += 1
end
say 'made' made
exit
try: procedure
  use arg text
  signal on syntax name refused
  return SysWordexp(text)~items
refused:
  return condition('o')~code condition('d')
