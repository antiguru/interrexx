# The host decides some of these answers (`docs/design/decisions.md`): access with an unknown mode
# bit (refused on Linux, not on macOS), setpgid of a negative pid (EINVAL on Linux, ESRCH on
# macOS), chroot's refusal, and SysSetuid, which on macOS changes nothing where it cannot drop the
# supplementary groups. These answers are
# interrexx's on macOS, recorded on a CI runner; the oracle has not been run there.
# Files, in the case's own directory, which holds the file f and the
# directory sub. Relative names are the program's directory's.
program
call directory '{dir}'
call SysUmask 2
say 'umask' SysUmask(18) SysUmask(18)
say 'mkdir' SysMkdirUnix('m1', 511) SysStat('m1', 'p')
say 'mkdir again' SysMkdirUnix('m1', 448) SysGeterrno()
say 'rmdir' SysRmdirUnix('m1') '['SysStat('m1', 'p')']' SysGeterrno()
say 'rmdir again' SysRmdirUnix('m1') SysGeterrno()
say 'symlink' SysSymlink('f', 'ln') SysStat('ln', 'p') SysStat('ln', 's')
say 'dangling' SysSymlink('nothere', 'dl') '['SysStat('dl', 'p')']' SysGeterrno()
say 'link' SysLink('f', 'hl') SysStat('f', 'n') (SysStat('hl', 'i') = SysStat('f', 'i'))
say 'link again' SysLink('f', 'hl') SysGeterrno()
say 'unlink' SysUnlink('hl') SysUnlink('ln') SysUnlink('dl') SysStat('f', 'n')
say 'unlink again' SysUnlink('hl') SysGeterrno()
say 'chmod' SysChmod('f', 'rwsr-S--t') SysStat('f', 'p')
say 'chmod' SysChmod('f', 'rw-r-----') SysStat('f', 'p')
say 'chmod dir' SysChmod('sub', 'rwxr-x--T') SysStat('sub', 'p')
say 'chmod none' SysChmod('nothere', 'rw-r-----') SysGeterrno()
say 'access' SysAccess('f', 4) SysAccess('f', 1) SysGeterrno() SysAccess('nothere', 0) SysGeterrno()
say 'access bad mode' SysAccess('f', 8) SysGeterrno()
say 'euidaccess' SysEuidaccess('f', 2) SysEuidaccess('nothere', 0) SysGeterrno()
say 'chown' SysChown('f', -1, -1) SysLchown('f', -1, -1) SysChown('nothere', -1, -1) SysGeterrno()
say 'size' SysStat('f', 's') SysStat('f', 'Size') SysStat('sub', 'N') (SysStat('f', 'u') = SysGetuid()) (SysStat('f', 'g') = SysGetegid())
say 'notdir' '['SysStat('f/x', 's')']' SysGeterrno() '['SysStat('f/x', 'q')']'
d = SysGetdirlist('.')
say 'dirlist' d~class d~items d~hasItem('.') d~hasItem('..') d~hasItem('f') d~hasItem('sub')
say 'dirlist sub' SysGetdirlist('sub')~sort~toString('L', ',')
say 'dirlist none' SysGetdirlist('nothere')~class SysGetdirlist('nothere')~items SysGeterrno()
say 'dirlist file' SysGetdirlist('f')~items SysGeterrno()
say 'close' SysClose(-1) SysGeterrno()
say 'sticky' SysClose(-1) SysAccess('.', 0) SysMkdirUnix('m2', 448) SysRmdirUnix('m2') SysGeterrno()
say 'kill self' SysKill(SysGetpid(), 0) SysKill(SysGetpid(), 999) SysGeterrno()
say 'kill none' SysKill(2147483647, 0) SysGeterrno()
say 'sid none' SysGetsid(2147483647) SysGeterrno() SysGetpgid(2147483647) SysGeterrno()
say 'setpgid none' SysSetpgid(2147483647, 0) SysGeterrno() SysSetpgid(-1, 0) SysGeterrno()
say 'own ids' SysSeteuid(SysGeteuid()) SysSetegid(SysGetegid()) SysSetgid(SysGetgid()) SysSetuid(SysGetuid())
say 'chroot' SysChroot('sub') SysGeterrno() directory()
::requires 'rxunixsys' LIBRARY
----
rc 0
[stdout]
umask 2 18
mkdir 0 drwxr-xr-x
mkdir again -1 17
rmdir 0 [] 2
rmdir again -1 2
symlink 0 -rw-rw-r-- 6
dangling 0 [] 2
link 0 2 1
link again -1 17
unlink 0 0 0 1
unlink again -1 2
chmod 0 -rwsr-S--t
chmod 0 -rw-r-----
chmod dir 0 drwxr-x--T
chmod none -1 2
access 0 -1 13 -1 2
access bad mode 0 2
euidaccess 0 -1 2
chown 0 0 -1 2
size 6 6 2 1 1
notdir [] 20 []
dirlist The Array class 5 1 1 1 1
dirlist sub .,..
dirlist none The Array class 0 2
dirlist file 0 20
close -1 9
sticky -1 0 0 0 9
kill self 0 -1 22
kill none -1 3
sid none -1 3 -1 3
setpgid none -1 3 -1 3
own ids 0 0 0 -1
chroot -1 1 /
[stderr]
