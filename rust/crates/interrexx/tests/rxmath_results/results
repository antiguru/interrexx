# Review Focus 2: MathLoadFuncs registers nothing the load did not, and RxFuncDrop of one leaves every routine callable.
program
say RxFuncAdd('MathLoadFuncs', 'rxmath', 'MathLoadFuncs')
call MathLoadFuncs
names = 'MathLoadFuncs MathDropFuncs RxCalcPi RxCalcSqrt RxCalcExp RxCalcLog RxCalcLog10 RxCalcSinH RxCalcCosH RxCalcTanH RxCalcPower RxCalcSin RxCalcCos RxCalcTan RxCalcCotan RxCalcArcSin RxCalcArcCos RxCalcArcTan'
do n over names~subwords
  q = RxFuncQuery(n)
  select
    when n = 'RxCalcPi' then v = RxCalcPi(4)
    when n = 'RxCalcPower' then v = RxCalcPower(0.5, 2, 4)
    when n~left(6) = 'RxCalc' then interpret 'v =' n'(0.5, 4)'
    otherwise v = '-'
  end
  say n q v
end
say RxFuncDrop('RxCalcTanH') RxFuncQuery('RxCalcTanH') RxCalcTanH(1) RxCalcCosH(1)
say RxFuncDrop('RxCalcCosH') RxCalcCosH(1)
