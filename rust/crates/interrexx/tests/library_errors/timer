# Alarm and Ticker: the argument-count errors of the readers and of cancel
# that the pages do not print. Each answer is the code with its subcode.
# A target is a Message, which implements AlarmNotification.

program
a = .alarm~new(600, .message~new(.object~new, 'x'))
signal on syntax name h
v = a~cancelled(1)
say 'no error'
a~cancel
exit
h: say condition('o')~code
a~cancel
