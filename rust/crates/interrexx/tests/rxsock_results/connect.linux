# How a connect to each address fails is the host's (`docs/design/decisions.md`).
# Stem arguments: a stem object, `name`, `name.` and `name.tail` (whose
# tail prefixes every element, a trailing dot kept); a name that is no stem
# answers 0 at once. Address stems: family AF_INET or a number, port modulo
# 65536, addresses in inet_addr's classic forms, 255.255.255.255 for
# invalid text, and the all-zero address where an element is unset.
program
l = SockSocket('AF_INET', 'SOCK_STREAM', '0')
a.family = ' af_inet '; a.port = 0; a.addr = ' 127.1 '
say 'bind' SockBind(l, 'a') errno
say 'name' SockGetSockName(l, 'b.!') b.!family b.!addr (b.!port > 0)
say 'name' SockGetSockName(l, 'c.x') c.xfamily c.xaddr (c.xport = b.!port)
say 'name' SockGetSockName(l, 'q.ab.') q.ab.family q.ab.addr
s.!family = 1
say 'name' SockGetSockName(l, s.) s.!family s.family s.addr
say 'name' SockGetSockName(l, '1abc') SockGetSockName(l, '')
say 'listen' SockListen(l, 5)
c = SockSocket('AF_INET', 'SOCK_STREAM', '0')
t.family = 2; t.port = b.!port + 65536; t.addr = '0x7f.0.1'
say 'connect' SockConnect(c, 't.') errno
s = SockAccept(l, 'p.')
say 'accept' (s > 0) p.family p.addr
d = SockSocket('AF_INET', 'SOCK_STREAM', '0')
t.family = 'AF_INET'; t.port = 1; t.addr = 'junk'
say 'connect' SockConnect(d, 't.') errno
t.family = 5; t.addr = '127.0.0.1'
say 'connect' SockConnect(d, 't.') errno
drop t.addr
say 'connect' SockConnect(d, 't.') errno
e = SockSocket('AF_INET', 'SOCK_STREAM', '0')
z.family = 0; z.port = 0; z.addr = '0.0.0.0'
say 'bind0' SockBind(e, 'z.') errno
z.addr = '127.0.0.1'
say 'bind0' SockBind(SockSocket('AF_INET', 'SOCK_STREAM', '0'), 'z.') errno
z.family = 7
say 'bind7' SockBind(SockSocket('AF_INET', 'SOCK_STREAM', '0'), 'z.') errno
f = SockSocket('AF_INET', 'SOCK_STREAM', '0')
say 'refused' SockConnect(f, 'a.') errno
say 'unbound' SockGetSockName(f, 'u.') u.family u.addr
say 'unconnected' SockGetPeerName(f, 'u.') errno
say SockClose(c) SockClose(s) SockClose(l) SockClose(d) SockClose(e) SockClose(f)
::requires 'rxsock' LIBRARY
----
rc 0
[stdout]
bind 0 0
name 0 2 127.0.0.1 1
name 0 2 127.0.0.1 1
name 0 2 127.0.0.1
name 0 1 2 127.0.0.1
name 0 0
listen 0
connect 0 0
accept 1 2 127.0.0.1
connect -1 ENETUNREACH
connect -1 EAFNOSUPPORT
connect 0 0
bind0 0 0
bind0 -1 EAFNOSUPPORT
bind7 -1 EAFNOSUPPORT
refused -1 ECONNREFUSED
unbound 0 2 0.0.0.0
unconnected -1 ENOTCONN
0 0 0 0 0 0
[stderr]
