verdict: procedure
  use arg c, a, sub
  if a == '-' then return made(c, sub)
  -- ooRexx refuses `new` on a TraceObject subclass (41.1), interrexx does not
  if sub > 0 & c~id~upper == 'TRACEOBJECT' then return 'skipped'
