      al = c~new(.timespan~fromHours(20), .message~new(.nil, 'X'))
      r = judge(al); al~cancel; return r
    end
    when timed then do
      tk = c~new(.timespan~fromHours(20), .message~new(.nil, 'X'))
      r = judge(tk); tk~cancel; return r
    end
    otherwise return 'skipped'
  end
judge: procedure
  use arg o
  .x~ans = o
  rq = asked(o)
  t = .x~new || ''
  if t == 'a X' then return 'default'rq
  if t == 'ms' then return 'own'rq
