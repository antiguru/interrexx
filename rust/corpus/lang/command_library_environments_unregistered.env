# The oracle's own compiled extensions: its library directory, and the
# harness's instrument directory, where librxsockc.so and librxunixsysc.so link
# to its librxsock.so and librxunixsys.so. This crate answers rxsock and
# rxunixsys with libraries of its own, so this program names the links to reach
# the shared-library path on both sides. The spawned side is given these
# directories as well; the in-process side reads them from here because the
# process loader cannot be told later.
LD_LIBRARY_PATH={oraclelib}:{instruments}
